<UserControl x:Class="TripleDetection.Views.DetectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：VisionMaster 显示区域 -->
        <Border Grid.Row="0" Grid.Column="0" Margin="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Border x:Name="VmRenderHost" Background="#F5F5F5"/>
                <TextBlock Text="VisionMaster 显示区域" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="14" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- 右侧：VM 操作面板 -->
        <Border Grid.Row="0" Grid.Column="1" Margin="0,5,5,5" Background="{StaticResource CardBackgroundBrush}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 任务选择 -->
                    <TextBlock Text="任务选择" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                    <ComboBox x:Name="cmbTaskSelect" Width="300" Margin="0,0,0,12"
                             SelectionChanged="CmbTask_SelectionChanged"/>
                    <!-- 已选任务信息 -->
                    <TextBlock Text="已选任务信息" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="txtProduct" Text="产品: --" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>
                            <TextBlock x:Name="txtBatch" Text="批次: --" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>
                            <TextBlock x:Name="txtProductionDate" Text="生产日期: --" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>
                            <TextBlock x:Name="txtExpirationDate" Text="有效期至: --" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>
                            <TextBlock x:Name="txtSolFilePath" Text="方案路径: --" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <!-- 方案操作 -->
                    <TextBlock Text="方案操作" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="btnSelectSol" Content="选择方案" Click="BtnSelectSol_Click"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="btnLoadSol" Content="加载方案" Click="BtnLoadSol_Click"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="btnSaveSol" Content="三期ToVM" Click="BtnSaveSol_Click"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="btnSyncBn" Content="同步BN" Click="BtnSyncBn_Click"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="btnLoadFromVm" Content="三期FromVM" Click="BtnLoadFromVm_Click"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>

                    <!-- 流程操作 -->
                    <TextBlock Text="流程操作" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                    <StackPanel Margin="0,0,0,12">
                        <ComboBox x:Name="cmbProcedure" Width="200" Margin="0,0,0,8"
                                  SelectionChanged="CmbProcedure_SelectionChanged"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnRunOnce" Content="单次运行" Click="BtnTaskRun_Click"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button x:Name="btnContiRun" Content="连续运行" Click="BtnTaskPause_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 检测统计 -->
                    <TextBlock Text="检测统计" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="txtOkCount" Text="OK: 0" Foreground="#00C000" Margin="0,0,16,0"/>
                                <TextBlock x:Name="txtNgCount" Text="NG: 0" Foreground="#FF0000"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="合格率: " Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="txtPassRate" Text="--" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 操作日志 -->
                    <TextBlock Text="操作日志" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" Height="120">
                        <ListBox x:Name="lstLogs" Background="White" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="0" FontFamily="Consolas" FontSize="11"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 底部：检测结果 -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,0,5,5" Background="{StaticResource CardBackgroundBrush}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <!-- 检测结果列表 -->
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,12,0">
                    <ListBox x:Name="lstDetectionLogs" Background="White" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderThickness="0" FontFamily="Consolas" FontSize="11"/>
                </Border>

                <!-- 当次结果 OK/NG 大字 -->
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Viewbox>
                        <TextBlock x:Name="txtCurrentResult" Text="--" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Viewbox>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>