<UserControl x:Class="TripleDetection.Views.DetectionHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 搜索条件栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="开始日期" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="dpStartDate" Width="120" Margin="0,0,15,0"/>
            <TextBlock Text="结束日期" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="dpEndDate" Width="120" Margin="0,0,15,0"/>

            <TextBlock Text="批次号" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtBatchNumber" Width="100" Margin="0,0,15,0"/>

            <TextBlock Text="结果" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="cmbResult" Width="80" Margin="0,0,15,0">
                <ComboBoxItem Content="全部" Tag=""/>
                <ComboBoxItem Content="OK" Tag="true"/>
                <ComboBoxItem Content="NG" Tag="false"/>
            </ComboBox>

            <Button x:Name="btnSearch" Content="查询" Width="60" Click="BtnSearch_Click" Margin="0,0,10,0"/>
            <Button x:Name="btnExport" Content="导出" Width="60" Click="BtnExport_Click"/>
        </StackPanel>

        <!-- 结果列表 -->
        <DataGrid Grid.Row="1" x:Name="dgDetectionRecords" AutoGenerateColumns="False" Margin="10,0,10,10" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="检测时间" Binding="{Binding DetectionTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140"/>
                <DataGridTextColumn Header="批次号" Binding="{Binding BatchNumber}" Width="120"/>
                <DataGridTextColumn Header="结果" Binding="{Binding IsOK, Converter={StaticResource BoolToResultConverter}}" Width="60"/>
                <DataGridTextColumn Header="置信度" Binding="{Binding Confidence, StringFormat=P2}" Width="80"/>
                <DataGridTextColumn Header="字符数" Binding="{Binding CharCount}" Width="60"/>
                <DataGridTextColumn Header="识别内容" Binding="{Binding CodeInfo}" Width="*"/>
                <DataGridTextColumn Header="耗时(ms)" Binding="{Binding ElapsedMs}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 分页栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,0,10,10">
            <TextBlock Text="共" VerticalAlignment="Center"/>
            <TextBlock x:Name="txtTotalCount" Text="0" VerticalAlignment="Center" Margin="5,0"/>
            <TextBlock Text="条" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <Button x:Name="btnPrev" Content="上一页" Width="60" Click="BtnPrev_Click" Margin="0,0,10,0"/>
            <TextBlock Text="第" VerticalAlignment="Center"/>
            <TextBlock x:Name="txtPageIndex" Text="1" VerticalAlignment="Center" Margin="5,0"/>
            <TextBlock Text="页" VerticalAlignment="Center"/>
            <Button x:Name="btnNext" Content="下一页" Width="60" Click="BtnNext_Click" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>