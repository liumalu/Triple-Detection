<UserControl x:Class="TripleDetection.Views.Settings.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="系统设置" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

            <!-- 日志设置 -->
            <TextBlock Text="日志设置" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
            <Border Background="{StaticResource CardBackgroundBrush}" Padding="16" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="日志保存方式:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cboLogSaveMethod" Margin="0,0,0,8">
                        <ComboBoxItem Content="按日期分目录" Tag="ByDate" IsSelected="True"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="日志保存天数:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="txtLogRetentionDays" Width="100"/>
                        <TextBlock Text="天 (0=不清理)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="日志导出目录:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="txtLogExportPath"/>
                        <Button Grid.Column="1" Content="浏览..." Click="BrowseLogExport_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/>
                    </Grid>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="自动清理日志:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <CheckBox Grid.Row="3" Grid.Column="1" x:Name="chkAutoCleanLog" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 工厂信息 -->
            <TextBlock Text="工厂信息" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
            <Border Background="{StaticResource CardBackgroundBrush}" Padding="16" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="工厂编号:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtFactoryCode" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="生产线号:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtProductionLine"/>
                </Grid>
            </Border>

            <!-- 数据备份 -->
            <TextBlock Text="数据备份" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
            <Border Background="{StaticResource CardBackgroundBrush}" Padding="16" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="数据库备份目录:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Grid.Column="1" x:Name="txtDbBackupRoot"/>
                    <Button Grid.Column="2" Content="浏览..." Click="BrowseDbBackup_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- 图片管理 -->
            <TextBlock Text="图片管理" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
            <Border Background="{StaticResource CardBackgroundBrush}" Padding="16" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="图片保留个数:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="txtImageRetentionCount" Width="100"/>
                        <TextBlock Text="个 (0=保留全部)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="自动清图:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <CheckBox Grid.Row="1" Grid.Column="1" x:Name="chkAutoCleanImages" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Button Content="保存设置" Click="SaveButton_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>