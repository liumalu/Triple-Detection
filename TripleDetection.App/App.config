<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- VisionMaster 安装路径: 4.2.0 默认路径 C:\Program Files\VisionMaster4.2.0 -->
    <!-- 4.3 版本路径通常为 C:\Program Files\VisionMaster4.3.0，修改下方路径即可 -->
    <add key="VmInstallPath" value="C:\Program Files\VisionMaster4.2.0" />
    <add key="LocalLibsPath" value="libs" />
    <add key="SolFilePath" value="D:\xcm\ApplicationDemo\OCRDemoCs\OCRDemoChinese.sol" />
    <add key="OkImageDir" value="D:\Images\OK" />
    <add key="NgImageDir" value="D:\Images\NG" />
    <add key="SystemLogoPath" value="Resources/logo.png" />
    <add key="LoginLogoPath" value="Resources/logo.png" />
    <add key="SystemName" value="Triple Detection" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  </configuration>