<UserControl x:Class="TripleDetection.Presentation.Views.Settings.VmSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/">
    <Grid MaxWidth="600" HorizontalAlignment="Left">
        <StackPanel>
            <TextBlock Text="VisionMaster 设置" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="安装路径" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBox Text="{Binding VmInstallPath, UpdateSourceTrigger=PropertyChanged}"
                         Width="400" Height="28" VerticalContentAlignment="Center"/>
                <Button Content="Browse..." Command="{Binding BrowseCommand}" Margin="10,0,0,0" Padding="15,5"/>
            </StackPanel>

            <Button Content="保存" Command="{Binding SaveCommand}" Width="100" HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</UserControl>