<UserControl x:Class="TripleDetection.Presentation.Views.Audit.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 搜索条件栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="开始日期" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="dpStartDate" Width="120" Margin="0,0,15,0"/>
            <TextBlock Text="结束日期" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="dpEndDate" Width="120" Margin="0,0,15,0"/>

            <TextBlock Text="用户" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="cmbUser" Width="100" Margin="0,0,15,0"/>

            <TextBlock Text="操作类型" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="cmbAction" Width="80" Margin="0,0,15,0">
                <ComboBoxItem Content="全部" Tag=""/>
                <ComboBoxItem Content="登录" Tag="登录"/>
                <ComboBoxItem Content="登出" Tag="登出"/>
                <ComboBoxItem Content="创建" Tag="创建"/>
                <ComboBoxItem Content="修改" Tag="修改"/>
                <ComboBoxItem Content="删除" Tag="删除"/>
                <ComboBoxItem Content="审批" Tag="审批"/>
                <ComboBoxItem Content="启用" Tag="启用"/>
                <ComboBoxItem Content="禁用" Tag="禁用"/>
            </ComboBox>

            <TextBlock Text="对象类型" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="cmbObjectType" Width="80" Margin="0,0,15,0">
                <ComboBoxItem Content="全部" Tag=""/>
                <ComboBoxItem Content="User" Tag="User"/>
                <ComboBoxItem Content="Task" Tag="Task"/>
                <ComboBoxItem Content="Product" Tag="Product"/>
                <ComboBoxItem Content="Config" Tag="Config"/>
            </ComboBox>

            <TextBlock Text="关键词" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtKeyword" Width="100" Margin="0,0,15,0"/>

            <Button x:Name="btnSearch" Content="查询" Width="60" Click="BtnSearch_Click" Margin="0,0,10,0"/>
            <Button x:Name="btnExport" Content="导出" Width="60" Click="BtnExport_Click"/>
        </StackPanel>

        <!-- 结果列表 -->
        <DataGrid Grid.Row="1" x:Name="dgAuditLog" AutoGenerateColumns="False" Margin="10,0,10,10" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding CreateAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140"/>
                <DataGridTextColumn Header="用户" Binding="{Binding UserName}" Width="80"/>
                <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="60"/>
                <DataGridTextColumn Header="对象类型" Binding="{Binding ObjectType}" Width="80"/>
                <DataGridTextColumn Header="对象ID" Binding="{Binding ObjectId}" Width="60"/>
                <DataGridTextColumn Header="详情" Binding="{Binding Details}" Width="*"/>
                <DataGridTextColumn Header="IP地址" Binding="{Binding IpAddress}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 分页栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,0,10,10">
            <TextBlock Text="共" VerticalAlignment="Center"/>
            <TextBlock x:Name="txtTotalCount" Text="0" VerticalAlignment="Center" Margin="5,0"/>
            <TextBlock Text="条" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <Button x:Name="btnPrev" Content="上一页" Width="60" Click="BtnPrev_Click" Margin="0,0,10,0"/>
            <TextBlock Text="第" VerticalAlignment="Center"/>
            <TextBlock x:Name="txtPageIndex" Text="1" VerticalAlignment="Center" Margin="5,0"/>
            <TextBlock Text="页" VerticalAlignment="Center"/>
            <TextBlock Text="共" VerticalAlignment="Center" Margin="15,0,0,0"/>
            <TextBlock x:Name="txtTotalPages" Text="1" VerticalAlignment="Center" Margin="5,0"/>
            <TextBlock Text="页" VerticalAlignment="Center"/>
            <Button x:Name="btnNext" Content="下一页" Width="60" Click="BtnNext_Click" Margin="0,0,10,0"/>
            <ComboBox x:Name="cmbPageSize" Width="60" SelectedIndex="0" SelectionChanged="CmbPageSize_SelectionChanged">
                <ComboBoxItem Content="20" Tag="20"/>
                <ComboBoxItem Content="50" Tag="50"/>
                <ComboBoxItem Content="100" Tag="100"/>
            </ComboBox>
        </StackPanel>
    </Grid>
</UserControl>