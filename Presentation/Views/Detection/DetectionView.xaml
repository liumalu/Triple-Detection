<UserControl x:Class="TripleDetection.Presentation.Views.Detection.DetectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- ==================== Row 0: Task Selection (60%) + Statistics (40%) ==================== -->
        <Grid Grid.Row="0" Margin="5,5,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- Task Selection (60%) -->
            <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 第一行：任务选择 + 产品 + 方案路径 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="任务选择:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmbTaskSelect"
                              SelectionChanged="CmbTask_SelectionChanged" VerticalAlignment="Center" HorizontalAlignment="Left" Width="180"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="产品:" VerticalAlignment="Center" Margin="16,0,8,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtProduct" Text="--" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                             Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="方案路径:" VerticalAlignment="Center" Margin="16,0,8,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Grid.Row="0" Grid.Column="5" x:Name="txtSolFilePath" Text="--" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                             Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>

                    <!-- 第二行：批号 + 生产日期 + 有效期至 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="批号:" VerticalAlignment="Center" Margin="0,8,8,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtBatch" Text="--" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="0,8,0,0"
                             Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="生产日期:" VerticalAlignment="Center" Margin="16,8,8,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtProductionDate" Text="--" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="0,8,0,0"
                             Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock Grid.Row="1" Grid.Column="4" Text="有效期至:" VerticalAlignment="Center" Margin="16,8,8,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Grid.Row="1" Grid.Column="5" x:Name="txtExpirationDate" Text="--" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="0,8,0,0"
                             Foreground="{StaticResource TextPrimaryBrush}"/>
                </Grid>
            </Border>

            <!-- Statistics (40%) -->
            <Border Grid.Column="1" Margin="0,0,0,0" Background="{StaticResource CardBackgroundBrush}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,4,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="OK" Foreground="#00C000" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtOkCount" Text="0" Foreground="#00C000" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="4,0,4,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="NG" Foreground="#FF0000" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtNgCount" Text="0" Foreground="#FF0000" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="4,0,4,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Pass" Foreground="{StaticResource PrimaryBrush}" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtPassRate" Text="--" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="4,0,0,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Total" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtTotalCount" Text="0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== Row 1: VM Display (78%) + Detection Results (22%) ==================== -->
        <Grid Grid.Row="1" Margin="5,5,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78*"/>
                <ColumnDefinition Width="22*"/>
            </Grid.ColumnDefinitions>

            <!-- VM Display (78%) -->
            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Border x:Name="VmRenderHost" Background="#F5F5F5"/>
                    <TextBlock Text="VisionMaster 显示区域" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="14" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Detection Results (22%) -->
            <Border Grid.Column="1" Margin="0,0,0,0" Background="{StaticResource CardBackgroundBrush}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 本次结果 - 图标展示 -->
                    <Border Grid.Row="0" x:Name="borderCurrentResult" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- OK/NG 图标 -->
                            <Border Grid.Column="0" Width="50" Height="50" CornerRadius="25" Margin="0,0,12,0">
                                <Border.Background>
                                    <SolidColorBrush x:Name="brsResultIcon" Color="#808080"/>
                                </Border.Background>
                                <TextBlock x:Name="txtResultIcon" Text="--" FontSize="20" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- 结果文字 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="本次结果" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="txtCurrentResult" Text="--" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 结果日志 - 带独立标题 -->
                    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" Padding="8,6">
                                <TextBlock Text="结果日志" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <ListBox x:Name="lstDetectionLogs" Background="White" Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderThickness="0" FontFamily="Consolas" FontSize="10" Padding="4"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== Row 2: Operation Panel (78%) + Operation Logs (22%) ==================== -->
        <Grid Grid.Row="2" Margin="5,5,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78*"/>
                <ColumnDefinition Width="22*"/>
            </Grid.ColumnDefinitions>

            <!-- Operation Panel (78%) -->
            <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 第一块：方案操作 -->
                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,4,0" Padding="8">
                        <StackPanel>
                            <TextBlock Text="方案操作" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnSelectSol" Content="选择方案" Click="BtnSelectSol_Click"
                                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" Padding="8,4"/>
                                <Button x:Name="btnLoadSol" Content="加载方案" Click="BtnLoadSol_Click"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="8,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 第二块：三期参数（不显示 BN/Mfg/EXP） -->
                    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="4,0,4,0" Padding="8">
                        <StackPanel>
                            <TextBlock Text="三期参数" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnSaveSol" Content="三期ToVM" Click="BtnSaveSol_Click"
                                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" Padding="8,4"/>
                                <Button x:Name="btnLoadFromVm" Content="三期FromVM" Click="BtnLoadFromVm_Click"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="8,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 第三块：工序选择 -->
                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="4,0,0,0" Padding="8">
                        <StackPanel>
                            <TextBlock Text="工序选择" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                            <ComboBox x:Name="cmbProcedure" Margin="0,0,0,8" SelectionChanged="CmbProcedure_SelectionChanged"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnRunOnce" Content="单次运行" Click="BtnTaskRun_Click"
                                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" Padding="8,4"/>
                                <Button x:Name="btnContiRun" Content="连续运行" Click="BtnTaskPause_Click"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="8,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Operation Logs (22%) -->
            <Border Grid.Column="1" Margin="0,0,0,0" Background="{StaticResource CardBackgroundBrush}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="操作日志" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <ListBox x:Name="lstLogs" Background="White" Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="0" FontFamily="Consolas" FontSize="10"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>