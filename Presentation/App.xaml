<prism:PrismApplication x:Class="TripleDetection.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:TripleDetection.Presentation.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <converters:ProductStatusConverter x:Key="ProductStatusConverter"/>
            <converters:TaskStatusConverter x:Key="TaskStatusConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Presentation/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>